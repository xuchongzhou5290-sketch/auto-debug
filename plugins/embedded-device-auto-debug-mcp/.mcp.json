{
  "mcpServers": {
    "embedded-device-auto-debug": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\scripts\\launch-autodbg-mcp.ps1"
      ],
      "env": {
        "AUTO_DBG_MCP_LOG_DIR": ".autodbg",
        "PYTHONUTF8": "1"
      }
    }
  }
}
